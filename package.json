{
  "name": "arxiv-toolkit",
  "displayName": "ArXiv Toolkit",
  "version": "0.1.1",
  "description": "A Chrome/Edge extension to help you quickly scan through the flood of daily ArXiv papers.",
  "author": "Jiahao Zhang. <davidbill@outlook.com>",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@mantine/core": "^7.17.8",
    "@mantine/form": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@plasmohq/storage": "^1.15.0",
    "@tabler/icons-react": "^3.49.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "postcss": "^8.5.30",
    "postcss-preset-mantine": "1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": [
      "storage"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "lmdb",
      "msgpackr-extract",
      "sharp"
    ],
    "overrides": {
      "msgpackr@<1.10.1": "^1.12.1",
      "sharp": "^0.35.5",
      "content-security-policy-parser": "^0.6.0",
      "fflate@<0.8.3": "^0.8.3",
      "@vue/server-renderer": "^3.5.44",
      "browserslist": "^4.28.7",
      "svelte@4.2.2": "^4.2.20",
      "tsup": "^8.5.0",
      "postcss-selector-parser@6": "^7.1.0",
      "esbuild@<0.28.1": "^0.28.2"
    }
  },
  "packageManager": "pnpm@10.24.0"
}
